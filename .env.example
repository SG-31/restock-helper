# このファイルは設定の見本です。
# コピーして .env という名前のファイルを作り、値を書き換えてください。
# .env には実際のパスワードを書くため、Gitには含めません（.gitignoreで除外済み）。

# PostgreSQLの接続先（ローカルの例）
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/restock_helper

# セッション・flashメッセージ・CSRFトークンの署名に使う秘密の値
SECRET_KEY=change-this-to-a-random-string

# デバッグモード（開発中に詳しいエラーを見たいときだけ true）
FLASK_DEBUG=false